# Copy to .env and fill in real values: cp .env.example .env
# The postgres image initializes the database from these POSTGRES_* vars,
# and the API connects with the same credentials.

# --- PostgreSQL ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# How the API reaches Postgres (service name on the compose network).
DB_HOST=db
DB_PORT=5432

# --- Redis ---
REDIS_HOST=redis
